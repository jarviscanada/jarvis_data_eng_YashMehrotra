    {
      "text": "%sql\r\nSELECT wdi_gs.indicatorvalue AS value, \r\n       wdi_gs.year           AS year, \r\n       wdi_gs.countryname    AS country \r\nFROM   (SELECT Max(indicatorvalue) AS ind, \r\n               countryname \r\n        FROM   wdi_gs\r\n        WHERE  indicatorcode = 'NY.GDP.MKTP.KD.ZG' \r\n               AND indicatorvalue <> 0 \r\n        GROUP  BY countryname) t1 \r\n       INNER JOIN wdi_gs\r\n               ON t1.ind = wdi_gs.indicatorvalue \r\n                  AND t1.countryname = wdi_gs.countryname",
      "user": "anonymous",
