    {
      "text": "%spark.pyspark\r\nfrom pyspark.sql.functions import col, max as spark_max\r\n\r\nt1 = wdi_df \\\r\n    .filter((col(\"indicatorcode\") == 'NY.GDP.MKTP.KD.ZG') & (col(\"indicatorvalue\") != 0)) \\\r\n    .groupBy(\"countryname\") \\\r\n    .agg(spark_max(\"indicatorvalue\").alias(\"ind\")) \\\r\n    .alias(\"t1\")\r\n\r\nwdi_alias = wdi_df.alias(\"w\")\r\n\r\nresult_df = t1.join(\r\n    wdi_alias,\r\n    (col(\"t1.ind\") == col(\"w.indicatorvalue\")) & (col(\"t1.countryname\") == col(\"w.countryname\"))\r\n).select(\r\n    col(\"w.indicatorvalue\").alias(\"value\"),\r\n    col(\"w.year\").alias(\"year\"),\r\n    col(\"w.countryname\").alias(\"country\")\r\n)\r\n\r\nz.show(result_df)",
      "user": "anonymous",
