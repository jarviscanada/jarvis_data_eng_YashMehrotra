    {
      "text": "%md \n\n# Spark SQL vs Dataframe\n\n`%sql` is the Spark SQL interpreter\n\n`%spark.pyspark` is the PySpark interpreter\n\n`%spark` is the Spark Scala interpreter",
      "user": "anonymous",
      "dateUpdated": "2026-07-06T13:07:26+0000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
